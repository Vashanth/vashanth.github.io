---
interface Props {
  speed?: number;
  backgroundColor?: string;
}

const { speed = 0.5, backgroundColor = "black" } = Astro.props;
---

<div id="starfield-container" class="fixed inset-0 min-h-screen w-full -z-50 pointer-events-none">
  <canvas id="starfield-canvas"></canvas>
</div>

<style>
  #starfield-container {
    background: radial-gradient(ellipse at bottom, #0d1d31 0%, #0c0d13 100%);
    overflow: hidden;
  }
</style>

<script>
  class Star {
    x: number;
    y: number;
    z: number;
    size: number;
    baseOpacity: number;
    opacity: number;
    twinkleSpeed: number;
    twinklePhase: number;

    constructor(width: number, height: number) {
      this.x = Math.random() * width;
      this.y = Math.random() * height;
      this.z = Math.random();
      this.size = Math.random() * 1.5 + 0.5;
      this.baseOpacity = Math.random() * 0.5 + 0.1;
      this.opacity = this.baseOpacity;
      this.twinkleSpeed = Math.random() * 0.02 + 0.005;
      this.twinklePhase = Math.random() * Math.PI * 2;
    }

    update(width: number, height: number, speed: number) {
      this.y -= speed * (this.z * 0.5 + 0.1);
      if (this.y < 0) {
        this.y = height;
        this.x = Math.random() * width;
      }
      this.twinklePhase += this.twinkleSpeed;
      this.opacity = this.baseOpacity + Math.sin(this.twinklePhase) * 0.1;
      if (this.opacity < 0) this.opacity = 0;
      if (this.opacity > 1) this.opacity = 1;
    }

    draw(ctx: CanvasRenderingContext2D) {
      const depth = 1 - this.z;
      const color = 200 + depth * 55;
      ctx.fillStyle = `rgba(${color}, ${color}, ${255}, ${this.opacity})`;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size * (depth * 0.5 + 0.5), 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Helper to setup and run animation
  function setupStarfield() {
    const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = window.innerWidth;
    let height = window.innerHeight;
    let stars: Star[] = [];
    let animationFrameId: number;
    
    // Config
    const STAR_COUNT_DESKTOP = 200;
    const STAR_COUNT_MOBILE = 80;
    const SPEED = 0.2;

    const init = () => {
      const isMobile = window.innerWidth < 768;
      const count = isMobile ? STAR_COUNT_MOBILE : STAR_COUNT_DESKTOP;
      
      resize();
      
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push(new Star(width, height));
      }
    };

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      if (ctx) ctx.scale(dpr, dpr);
    };

    const animate = () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      ctx.clearRect(0, 0, width, height);

      stars.forEach(star => {
        star.update(width, height, SPEED);
        star.draw(ctx);
      });

      animationFrameId = requestAnimationFrame(animate);
    };

    const start = () => {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      init();
      animate();
    };

    // Initialize
    start();

    // Event Listeners
    const onResize = () => {
      resize();
    };

    const onVisibilityChange = () => {
      if (document.hidden) {
        cancelAnimationFrame(animationFrameId);
      } else {
        animate();
      }
    };

    window.addEventListener('resize', onResize);
    document.addEventListener('visibilitychange', onVisibilityChange);

    // Cleanup function to remove listeners if component is destroyed
    // (Though with persist it stays, but good practice)
    return () => {
      window.removeEventListener('resize', onResize);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      cancelAnimationFrame(animationFrameId);
    };
  }

  // Run on page load (initial and after navigation)
  document.addEventListener('astro:page-load', () => {    
    const canvas = document.getElementById('starfield-canvas');
    if (canvas) {
        if (canvas._starfieldCleanup) {
            canvas._starfieldCleanup();
        }
        
        const cleanup = setupStarfield();
        canvas._starfieldCleanup = cleanup;
    }
  }, { once: false });
</script>
