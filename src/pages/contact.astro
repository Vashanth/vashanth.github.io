---
import Layout from '../layouts/Layout.astro';

const contactMethods = [
  {
    name: 'Email',
    value: 'vashanth.sa@gmail.com',
    href: 'mailto:vashanth.sa@gmail.com',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    name: 'LinkedIn',
    value: 'vashanth-s',
    href: 'https://www.linkedin.com/in/vashanth-s',
    icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 2a2 2 0 1 1-2 2 2 2 0 0 1 2-2z'
  },
  {
    name: 'GitHub',
    value: 'Vashanth',
    href: 'https://github.com/Vashanth',
    icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'
  }
];
---

<Layout 
  title="Contact"
  description="Get in touch with Vashanth Saravanan. Open to opportunities, collaborations, and technical discussions."
>
  <section class="section-container pt-32 pb-40 min-h-[80vh] flex flex-col justify-center">
    <div class="max-w-3xl space-y-6 mb-20 animate-in">
      <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Connect</h2>
      <h1 class="text-gradient font-extrabold leading-tight">Get in Touch.</h1>
      <p class="text-xl text-text-secondary leading-relaxed">
        I'm always open to new opportunities, interesting projects, or just a good conversation about technology.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-in" style="animation-delay: 150ms">
      {contactMethods.map((method) => (
        <a 
          href={method.href}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card p-10 flex flex-col items-center text-center space-y-6 group"
        >
          <div class="p-4 rounded-2xl bg-zinc-900 border border-zinc-800 text-text-primary group-hover:text-accent group-hover:border-accent/30 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={method.icon}></path>
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="text-sm font-bold uppercase tracking-widest text-text-tertiary">{method.name}</h3>
            <p class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors">{method.value}</p>
          </div>
          <span class="text-xs font-bold text-accent opacity-0 group-hover:opacity-100 transition-opacity">Connect →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
