---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import vashanthImg from '../assets/vashanth.jpg';

const highlights = [
  {
    company: 'Docusign',
    role: 'Software Engineer III',
    period: '2026 - Present',
    description: 'Backend engineer on the eSign reporting team, using C# and .NET.'
  },
  {
    company: 'Wayground (Quizizz)',
    role: 'Software Engineer',
    period: '2023 - 2026',
    description: 'Building scalable EdTech systems serving millions. Working on backend systems in Golang.'
  },
  {
    company: 'Postman',
    role: 'Software Engineer',
    period: '2021 - 2023',
    description: 'Full-stack development for Public and Private API Networks using React, Node.js, and AWS.'
  }
];

const skills = [
  { category: 'Languages', items: ['Golang', 'JavaScript', 'C++', 'SQL'] },
  { category: 'Frameworks', items: ['Node.js', 'React', 'Vue.js', 'Sails JS'] },
  { category: 'Infrastructure', items: ['AWS', 'API Design', 'Scalable Systems'] }
];
---

<Layout 
  title="Full Stack Software Engineer"
  description="Vashanth Saravanan is a Software Engineer III at Docusign. Previously at Wayground and Postman working on scalable systems and developer tools. Full-stack expertise in Vue.js, React, Node.js, and Golang."
>
  <!-- Hero Section -->
  <section class="section-container pt-32 pb-24 md:pt-48 md:pb-32">
    <div class="max-w-3xl space-y-8 animate-in">
      <div class="flex flex-col md:flex-row md:items-center gap-8 mb-8">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-accent to-indigo-500 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
          <Image 
            src={vashanthImg} 
            alt="Vashanth Saravanan" 
            transition:name="hero-photo"
            class="relative w-24 h-24 md:w-32 md:h-32 rounded-full object-cover border-2 border-zinc-800 shadow-2xl"
            loading="eager"
            width={128}
            height={128}
          />
        </div>
        <div class="space-y-4">
          <h1 class="font-display font-extrabold text-gradient leading-[1.1]">
            Building scalable systems <br class="hidden md:block" /> with precision & purpose.
          </h1>
          <p class="text-xl md:text-2xl font-medium text-text-secondary max-w-2xl leading-relaxed">
            I'm <span class="text-text-primary">Vashanth Saravanan</span>, a Software Engineer III at Docusign. 
            Specializing in end-to-end development.
          </p>
        </div>
      </div>
      
      <div class="flex flex-wrap gap-4 pt-4">
        <a href="/projects" class="px-8 py-4 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-all shadow-xl shadow-white/5">
          View Projects
        </a>
        <a href="/contact" class="px-8 py-4 bg-zinc-900 text-text-primary font-bold rounded-full border border-zinc-800 hover:border-zinc-700 transition-all">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Experience Highlights -->
  <section class="section-container py-24 border-t border-zinc-800/50">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 lg:gap-24">
      <div class="space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Selected Experience</h2>
        <p class="text-text-secondary">A glimpse into my professional journey building world-class products.</p>
      </div>
      
      <div class="lg:col-span-2 space-y-12">
        {highlights.map(exp => (
          <div class="group relative space-y-3">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
              <h3 class="text-xl font-bold text-text-primary group-hover:text-accent transition-colors">{exp.company}</h3>
              <span class="text-sm font-bold text-text-tertiary">{exp.period}</span>
            </div>
            <p class="text-lg font-medium text-text-secondary">{exp.role}</p>
            <p class="text-text-tertiary leading-relaxed max-w-xl">{exp.description}</p>
          </div>
        ))}
        
        <a href="/experience" class="inline-flex items-center gap-2 text-sm font-bold text-text-primary hover:text-accent transition-colors group">
          Full Experience
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Skills Overview -->
  <section class="section-container py-24 mb-20 border-t border-zinc-800/50">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 lg:gap-24">
      <div class="space-y-4">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Core Expertise</h2>
        <p class="text-text-secondary">Robust foundations and modern technologies I use to solve complex problems.</p>
      </div>
      
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-12">
        {skills.map(skill => (
          <div class="space-y-4">
            <h3 class="text-sm font-bold text-text-primary uppercase tracking-widest">{skill.category}</h3>
            <div class="flex flex-wrap gap-2">
              {skill.items.map(item => (
                <span class="px-3 py-1 bg-zinc-900 border border-zinc-800 rounded-md text-xs font-bold text-text-secondary">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
