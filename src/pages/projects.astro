---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Blind Assist',
    description: 'Mobile application using transfer learning with MobileNet to assist visually impaired individuals by identifying objects in real-time through their smartphone camera.',
    tech: ['JavaScript', 'TensorFlow', 'Mobile Development', 'Machine Learning'],
    link: 'https://blind-assist.web.app/',
    github: 'https://github.com/Vashanth/Blind_Assist',
    featured: true
  },

  {
    title: 'Chat Application',
    description: 'Real-time chat application built with Socket.io enabling instant messaging between users with clean, responsive interface.',
    tech: ['Node.js', 'Socket.io', 'JavaScript', 'Real-time Systems'],
    link: 'https://chat-app-vash.netlify.app/',
    featured: true
  },

  {
    title: 'COVID-19 Tracker',
    description: 'Real-time dashboard tracking COVID-19 statistics with data visualization and regional breakdowns.',
    tech: ['JavaScript', 'API Integration', 'Data Visualization'],
    link: 'http://aws-webinar-vash.s3-website.us-east-2.amazonaws.com/',
    github: 'https://github.com/Vashanth/COVID19_web'
  },
  {
    title: 'JSON Schema Generator',
    description: 'Developer tool for automatically generating JSON schemas from sample JSON data, streamlining API development workflows.',
    tech: ['JavaScript', 'Developer Tools', 'JSON Processing'],
    link: 'https://vash-430f0.firebaseapp.com/'
  }
];
---

<Layout 
  title="Projects"
  description="Portfolio of projects by Vashanth S, showcasing full-stack development, AI applications, real-time systems, and developer tools."
>
  <section class="section-container pt-32 pb-24">
    <div class="max-w-3xl space-y-6 mb-20 animate-in">
      <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Portfolio</h2>
      <h1 class="text-gradient font-extrabold leading-tight">Recent Projects</h1>
      <p class="text-xl text-text-secondary leading-relaxed">
        A collection of meaningful projects showcasing real-world applications, system design, and technical depth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project, index) => (
        <article 
          class="glass-card p-8 flex flex-col h-full"
        >
          <div class="flex-1 space-y-4">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold text-text-primary tracking-tight">{project.title}</h3>
              {project.featured && (
                <span class="px-2 py-0.5 rounded-full bg-accent/10 border border-accent/20 text-[10px] font-bold uppercase tracking-widest text-accent">
                  Featured
                </span>
              )}
            </div>
            
            <p class="text-sm text-text-secondary leading-relaxed line-clamp-4">
              {project.description}
            </p>
            
            <div class="flex flex-wrap gap-2 pt-2">
              {project.tech.map(tech => (
                <span class="px-2 py-1 bg-zinc-950 border border-zinc-800/50 rounded text-[10px] font-bold text-text-tertiary uppercase tracking-wider">
                  {tech}
                </span>
              ))}
            </div>
          </div>
          
          <div class="flex items-center gap-4 mt-8 pt-6 border-t border-zinc-800/50">
            {project.link && (
              <a 
                href={project.link} 
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-text-primary hover:text-accent transition-colors flex items-center gap-1.5 group"
              >
                Live Demo
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"><path d="M7 7h10v10"/><path d="M7 17L17 7"/></svg>
              </a>
            )}
            {project.github && (
              <a 
                href={project.github} 
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-text-tertiary hover:text-text-primary transition-colors flex items-center gap-1.5"
              >
                GitHub
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- GitHub CTA -->
    <div class="mt-24 p-12 glass-card text-center space-y-6 animate-in">
      <h3 class="text-2xl font-bold text-text-primary">Want to see more?</h3>
      <p class="text-text-secondary max-w-xl mx-auto">
        I regularly contribute to open source and work on experiment projects. Check out my GitHub for the full collection.
      </p>
      <div class="pt-4">
        <a 
          href="https://github.com/Vashanth" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-all shadow-xl shadow-white/5"
        >
          Follow on GitHub
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
